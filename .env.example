# PostgreSQL connection string (automatically injected by Railway when you add a PostgreSQL service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tabula_loom

# Optional: Railway S3-Compatible Bucket credentials (or leave blank to use Railway Volume / local storage/)
BUCKET=
ENDPOINT=
REGION=auto
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=

# Optional: Railway Volume mount path
RAILWAY_VOLUME_MOUNT_PATH=
